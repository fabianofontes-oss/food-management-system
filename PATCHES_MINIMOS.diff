## PATCH #1: Validação de Assinatura no Webhook Mercado Pago

**Arquivo:** src/app/api/webhooks/mercadopago/route.ts
**Severidade:** 🔴 CRÍTICO (Bloqueador de go-live)
**Tempo:** 30min (S)

```diff
--- a/src/app/api/webhooks/mercadopago/route.ts
+++ b/src/app/api/webhooks/mercadopago/route.ts
@@ -1,5 +1,6 @@
 import { NextRequest, NextResponse } from 'next/server'
 import { processPaymentWebhook } from '@/lib/billing/mercadopago'
+import crypto from 'crypto'
 
 /**
  * Webhook do MercadoPago para receber notificações de pagamento
@@ -9,7 +10,35 @@
  * https://www.mercadopago.com.br/developers/panel/app
  */
 export async function POST(request: NextRequest) {
+  // SECURITY: Validar assinatura do webhook
+  const signature = request.headers.get('x-signature')
+  const requestId = request.headers.get('x-request-id')
+  
+  if (!signature || !requestId) {
+    console.error('[Webhook MP] Missing signature or request-id')
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+  }
+  
   try {
+    // Validar assinatura antes de processar
+    const secret = process.env.MP_WEBHOOK_SECRET
+    
+    if (!secret) {
+      console.error('[Webhook MP] MP_WEBHOOK_SECRET not configured')
+      return NextResponse.json({ error: 'Configuration error' }, { status: 500 })
+    }
+    
+    const body = await request.text()
+    const [ts, hash] = signature.split(',')
+    
+    const manifest = `id:${requestId};request-id:${requestId};ts:${ts};`
+    const hmac = crypto.createHmac('sha256', secret)
+    hmac.update(manifest + body)
+    const expectedHash = hmac.digest('hex')
+    
+    if (hash !== `v1=${expectedHash}`) {
+      console.error('[Webhook MP] Invalid signature')
+      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+    }
+    
-    const body = await request.json()
+    const parsedBody = JSON.parse(body)
     
-    console.log('Webhook MercadoPago recebido:', JSON.stringify(body, null, 2))
+    console.log('Webhook MercadoPago recebido (validado):', JSON.stringify(parsedBody, null, 2))
 
-    if (body.type === 'payment' && body.data?.id) {
-      const paymentId = body.data.id.toString()
+    if (parsedBody.type === 'payment' && parsedBody.data?.id) {
+      const paymentId = parsedBody.data.id.toString()
```

**Pós-aplicação:**
1. Adicionar `MP_WEBHOOK_SECRET` no `.env` e variáveis de ambiente de produção
2. Testar com evento real do Mercado Pago
3. Monitorar logs para tentativas de acesso não autorizado

